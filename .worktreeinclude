# Local-only inputs new worktrees need. One repo-relative path per line;
# comments start with '#'. Season ROM stashes are listed as folders so a
# ROM added to a season's .roms/ is picked up automatically, the same way
# .gitignore matches `**/.roms/` as a folder. Every path below is ignored by
# .gitignore and is never tracked.
#
# Deliberately excluded:
#   .venv/                     machine-specific virtualenv. Ignored by its own
#                              internal .venv/.gitignore, not by the repository
#                              .gitignore.
#   scripts/__pycache__/       regenerated by any python run
#   .playwright-cli/           scratch output, not an input
#   .secrets/hidden/           per-run private workspace. Copying one makes
#                              generation fail: generate_session.py refuses to
#                              overwrite an existing workspace directory.
#   .generated-secrets-hidden/ secrets; never copy them around

# Season ROM stashes (folder, not individual files).
2026/3. Fall/.roms/
2026/2. Summer/.roms/

# Root admin scripts and session id. session_id.env holds a live session
# identifier: it stays ignored and is never committed, but it is copied into
# every worktree that reads this file. Drop this line if that is not wanted.
.admin/

# Local Discord tracking bot. Only config.json moves: it holds the Discord
# token and room password that are defined once and reused. The clone's data
# folders (logs/, RegistrationData/, ItemQueue/, ArchData/) and .venv are
# rebuildable by re-cloning, so they stay behind and are not copied.
bridgeipelago/config.json
